# Zotero API-Key erstellen unter: https://www.zotero.org/settings/keys
# (Lese- und Schreibrechte für deine Library aktivieren)
VITE_ZOTERO_API_KEY=

# Deine numerische User-ID, ebenfalls auf zotero.org/settings/keys sichtbar
VITE_ZOTERO_USER_ID=

# Optional: Name einer bestehenden Zotero-Sammlung.
# Neue Paper landen dann dort statt in der Hauptbibliothek.
# Leer lassen = Hauptbibliothek.
VITE_ZOTERO_COLLECTION_NAME=
