# Create a Zotero API key at: https://www.zotero.org/settings/keys
# (Enable read and write access for your library)
VITE_ZOTERO_API_KEY=

# Your numeric user ID, also visible at zotero.org/settings/keys
VITE_ZOTERO_USER_ID=

# Optional: name of an existing Zotero collection.
# New papers will be added there instead of the main library.
# Leave empty = main library.
VITE_ZOTERO_COLLECTION_NAME=
